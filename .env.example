# ========================================================
# THRIVE WITH JUHI PARMAR — WORKSHOP CONFIGURATION (EXAMPLE)
# ========================================================
# Copy this file to .env or .env.local for local development,
# or configure these in:
# Vercel Dashboard -> Project Settings -> Environment Variables
# ========================================================

# --------------------------------------------------------
# 1. DATE VARIABLES
# --------------------------------------------------------
# Workshop Date Range (e.g. "22–23 Oct", "24–25th October", "7–8th November")
EVENT_DATE="22–23 Oct"

# Optional Day-specific dates (auto-computed from EVENT_DATE if omitted)
# EVENT_DAY1_DATE="22 Oct"
# EVENT_DAY2_DATE="23 Oct"

# Registration Closes Date (e.g. "21 Oct", defaults to 1 day before Day 1 if omitted)
REGISTRATION_CLOSES_DATE="21 Oct"

# --------------------------------------------------------
# 2. TIME VARIABLES
# --------------------------------------------------------
# Overall Workshop Timings summary (displayed in offer card and meta rows)
EVENT_TIME="Day 1: 10–11 AM · Day 2: 10–11:30 AM IST"

# Day 1 Session Time (e.g. "10:00 AM – 11:00 AM")
EVENT_DAY1_TIME="10:00 AM – 11:00 AM"

# Day 2 Session Time (e.g. "10:00 AM – 11:30 AM")
EVENT_DAY2_TIME="10:00 AM – 11:30 AM"

# Timezone (defaults to "IST")
EVENT_TIMEZONE="IST"

# --------------------------------------------------------
# 3. PRICE VARIABLES
# --------------------------------------------------------
# Workshop Special / Offer Price in INR (e.g. "99", "199", "₹99")
EVENT_PRICE="99"

# Regular / Strike-through Price in INR (e.g. "999", "1499", "₹999")
EVENT_ORIGINAL_PRICE="999"

# Discount Badge text (e.g. "90% OFF", auto-calculated from prices if omitted)
# EVENT_DISCOUNT="90% OFF"

# --------------------------------------------------------
# 4. THANK YOU PAGE (WHATSAPP BUTTON LINK)
# --------------------------------------------------------
# WhatsApp Group Invite link for the Thank You page CTA button
WHATSAPP_LINK="https://chat.whatsapp.com/DbON8aN8LckGfnUa5a6YAL?mode=gi_t"

# --------------------------------------------------------
# 5. OPTIONAL PAYMENT / CHECKOUT URL OVERRIDE
# --------------------------------------------------------
# Optional Razorpay checkout URL override for main landing pages
# EVENT_PAYMENT_URL="https://rzp.io/rzp/qnhXgZJ"
# EVENT_ORGANIC_PAYMENT_URL="https://rzp.io/rzp/Ng19H08"
